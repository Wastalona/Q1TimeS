@model List<Q1TimeS.Models.Db.Survey>
@{
    ViewData["Title"] = "Мастерская администратора";
    ViewData["StyleName"] = "admin/admin.css";
    ViewData["ScriptName"] = "admin/admin.js";
}

<div class="survey-list">
    @if (Model.Count == 0){
        <div class="none-block">
            <h1>Опросов ещё не создано</h1>
        </div>
    }else{
        @foreach (var survey in Model){
            <div class="survey-block" id="@survey.SurveyId">
                <div class="survey-header">
                    <div class="card-title col" onclick="go_stats('@survey.SurveyId')">
                        <h2>@survey.Title</h2>
                    </div>
                </div>
                <div class="survey-content" onclick="go_stats('@survey.SurveyId')">
                    @if (@survey.Description.Length > 0){
                        if (@survey.Description.Length <= 246)
                        {
                            <p>@survey.Description</p>
                        }
                        else
                        {
                            <p>Описание слишком большое, чтобы его можно было бы отобразить</p>
                        }
                    }else{
                        <p>Нет описания</p>
                    }
                </div>
                <div class="survey-footer">
                    <button name="delete-btn" id="csv-btn" class="styled-btn delete-btn" onclick="delete_survey('@survey.SurveyId')">
                        <i class='bx bx-trash'></i>
                    </button>
                </div>
            </div>
        }
    }
</div>

<div class="add-new">
    <div class="fill-btn" onclick="go_create()">
        <i class='bx bxs-layer-plus'></i>
        <span class="fill-btn-text">Добавить</span>
    </div>
</div>
