@model List<Q1TimeS.Models.Db.TrustedIP>
@{
    ViewData["Title"] = "Настройки доступа";
    ViewData["StyleName"] = "admin/access.css";
    ViewData["ScriptName"] = "admin/access.js";
}

<div class="cc access">
    <h1>Разрешённые IP-адреса</h1>
    <hr style="background-color: var(--primary); height: 3px; width: 100%;">
    <form class="cc" method="POST" action="Access">
        <input name="IPAddress"
               type="text"
               required
               placeholder="192.168.1.1"
               autocomplete="off"
               pattern="^((25[0-5]|2[0-4][0-9]|[0-1]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[0-1]?[0-9][0-9]?)$"
               title="Введите корректный IP-адрес" />
        <button name="download-btn" id="csv-btn" class="styled-btn" type="submit">
            <i class='bx bx-plus-medical'></i>
        </button>
    </form>
    @if (Model != null && Model.Count > 0)
    {
        <form class="cc" id="delete-form" onsubmit="delete_request(event)" method="POST">
            <ul id="ip-list">
                @foreach (var ip in Model)
                {
                    <li class="list-item">
                        <input type="checkbox" class="item-checkbox" name="SelectedIPs" value="@ip.AddressId" />
                        <span>@ip.IPaddress</span>
                    </li>
                }
            </ul>
            <div class="action-panel">
                <button type="button" class="styled-btn select-all-btn" onclick="toggleSelectAll()">
                    <i class='bx bx-list-ul'></i>
                </button>
                <button name="delete-btn" id="csv-btn" class="styled-btn delete-btn" type="submit">
                    <i class='bx bx-trash'></i>
                </button>
            </div>
        </form>
    }
    else
    {
        <h3>Нет доверенных адресов</h3>
    }
    
</div>